# TinyOS 2.1.2 + TOSSIM toolchain on Ubuntu 26.04 (resolute), 64-bit, Python 3.14.
#
# TinyOS from the 2.1.2-maintained branch of afbranco/tinyos-main (README.md, "TinyOS changes"),
# with the fixes of README.md. New here: GCC 15 (no GCC 10 in 26.04), hence fixes 9 to 11, and
# AVR mote builds (micaz, iris, mica2), fixes 12 and 13.
#
#   podman build -t tinyos-toolchain:2.1.2-resolute-py3 -f resolute-py3/Containerfile .
FROM docker.io/library/ubuntu:26.04

ARG NESC_TAG=v1.4.0
ARG NESC_SHA256=ea9a505d55e122bf413dff404bebfa869a8f0dd76a01a8efc7b4919c375ca000

ENV DEBIAN_FRONTEND=noninteractive

# Fix 1 (python-is-python3: the tools' configure looks for `python`), fix 2 (JDK), fix 3
# (avr-gcc), fix 4 (emacs/bison/flex/gperf for nesC from git). JDK 17, not 21: Avrora (2013)
# uses java.lang.Compiler, which Java 21 removed.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      ca-certificates curl make perl autoconf automake libtool \
      gcc g++ \
      python3 python3-dev python-is-python3 \
      openjdk-17-jdk-headless \
      gcc-avr avr-libc \
      bison flex gperf emacs-nox \
 && rm -rf /var/lib/apt/lists/*

# Fix 4: nesC 1.4.0 from the official repo. No "make -j": the emacs code generation races.
# Fix 9: nesC's libcpp writes U"string" meaning a cast macro, U = (const unsigned char *); since
# C11 that is a UTF-32 literal, an error from GCC 14 on. Build nesC as gnu89, its dialect.
RUN curl -fsSL -o /tmp/nesc.tar.gz https://codeload.github.com/tinyos/nesc/tar.gz/refs/tags/${NESC_TAG} \
 && echo "${NESC_SHA256}  /tmp/nesc.tar.gz" | sha256sum -c - \
 && mkdir /tmp/nesc && tar -xzf /tmp/nesc.tar.gz -C /tmp/nesc --strip-components=1 \
 && cd /tmp/nesc && ./Bootstrap && ./configure --prefix=/usr/local CFLAGS="-g -O2 -std=gnu89" && make && make install \
 && rm -rf /tmp/nesc /tmp/nesc.tar.gz

# TinyOS 2.1.2 with the Python 3 TOSSIM bindings, plus the tools the make system needs.
# Declared here, not at the top: a new fork commit then rebuilds only from this step on.
# Commit fc2953f of afbranco/tinyos-main, branch 2.1.2-maintained: release_tinyos_2_1_2 + Python 3
# bindings (da2f9d0) + upstream cbbddf66 (AVR progmem consts with newer gcc).
ARG TINYOS_REPO=afbranco/tinyos-main
ARG TINYOS_COMMIT=fc2953f5debb89ec20ea1162df8ff85304d27e0f
ARG TINYOS_SHA256=f7125717662a4ffb2ac1c079e3e0cd0a0301f5bd7ef3300154dfaffa9bb2d18d
ENV TOSROOT=/opt/tinyos-2.1.2
RUN curl -fsSL -o /tmp/tinyos.tar.gz https://codeload.github.com/${TINYOS_REPO}/tar.gz/${TINYOS_COMMIT} \
 && echo "${TINYOS_SHA256}  /tmp/tinyos.tar.gz" | sha256sum -c - \
 && mkdir -p ${TOSROOT} && tar -xzf /tmp/tinyos.tar.gz -C ${TOSROOT} --strip-components=1 \
 && rm /tmp/tinyos.tar.gz \
 && cd ${TOSROOT}/tools && ./Bootstrap && ./configure --prefix=/usr/local \
 && for d in tinyos/ncc tinyos/misc; do make -C $d && make -C $d install || exit 1; done

# Avrora, the AVR simulator (micaz, mica2), to run the firmware without a mote. BSD license.
ARG AVRORA_VERSION=1.7.117
ARG AVRORA_SHA256=fd72eb0a23377550bb48d8f0f84cec218a02fd769ac586999c57f52ae219c060
RUN curl -fsSL --retry 5 --retry-all-errors --connect-timeout 30 -o /opt/avrora.jar \
      https://downloads.sourceforge.net/project/avrora/avrora-beta-${AVRORA_VERSION}.jar \
 && echo "${AVRORA_SHA256}  /opt/avrora.jar" | sha256sum -c - \
 && printf '#!/bin/sh\nexec java -jar /opt/avrora.jar "$@"\n' > /usr/local/bin/avrora \
 && chmod +x /usr/local/bin/avrora

# Fixes 10 and 11: a gcc wrapper that sets the C dialect for TinyOS builds (see the file).
# Fixes 12 and 13: an avr-gcc wrapper for nesC's AVR builds (see the file).
COPY resolute-py3/gcc resolute-py3/avr-gcc /usr/local/bin/

# Fix 7: sim.extra only parses "Python 2.x" versions, so set it. Fix 5 and fix 8: as in
# jammy-py2. No PYTHONPATH: the TinyOS Python SDK (support/sdk/python) is Python 2 code.
ENV TOSDIR=${TOSROOT}/tos \
    MAKERULES=${TOSROOT}/support/make/Makerules \
    CLASSPATH=. \
    PYTHON_VERSION=3.14 \
    PFLAGS="-fgnu89-inline -D_Float32=float -D_Float64=double -D_Float32x=double -D_Float64x='long double' -D_Float128='long double'"

WORKDIR /work
